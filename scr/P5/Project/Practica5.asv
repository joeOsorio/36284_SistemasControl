%[text]{"align":"center"} %[text:anchor:T_67fd] # Practica 5: Modelado y simulación de sistemas dinámicos. 
%[text]{"align":"center"} ![escudo-uabc-2022-color-cont.png](text:image:9cc1) 
%[text]{"align":"center"} Materia: Sistemas de Control 
%[text]{"align":"center"} Alumnos: Joshua Osorio
%[text]{"align":"center"} Profesor`:`Luara Jimenez Beristain
